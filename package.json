{
  "name": "nanocss-compiler",
  "private": true,
  "version": "0.0.6",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "require": "./dist/index.cjs"
      }
    },
    "./postcss-plugin": {
      "import": {
        "types": "./dist/postcss-plugin.d.mts",
        "import": "./dist/postcss-plugin.mjs"
      },
      "require": {
        "types": "./dist/postcss-plugin.d.cts",
        "require": "./dist/postcss-plugin.cjs"
      }
    },
    "./transform": {
      "import": {
        "types": "./dist/transform.d.mts",
        "import": "./dist/transform.mjs"
      },
      "require": {
        "types": "./dist/transform.d.cts",
        "require": "./dist/transform.cjs"
      }
    },
    "./swc": "./dist/swc.wasm"
  },
  "scripts": {
    "build": "tsdown && bun run build:native",
    "build:native": "bun run build:swc && bun run build:node",
    "build:node": "cargo build -p nanocss_node --release && node scripts/copy-native-addon.mjs",
    "build:swc": "cargo build -p nanocss_swc --target wasm32-wasip1 --release && mkdir -p dist && cp target/wasm32-wasip1/release/nanocss_swc.wasm dist/swc.wasm",
    "test": "vitest"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@swc/core": "^1.15.33",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "react": "*"
  },
  "dependencies": {
    "postcss": "^8.5.13"
  }
}
